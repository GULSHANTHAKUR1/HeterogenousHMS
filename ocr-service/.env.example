# ==============================================================================
# HETEROGENEOUS HMS - OCR & NLP MICROSERVICE ENVIRONMENT TEMPLATE
# ==============================================================================

# Service Network Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Tesseract OCR Executable Binary Path on Windows 11
# Standard default installation location for 64-bit installer:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Shared Internal Authentication Secret
# Must match OCR_SERVICE_SECRET configured in backend/.env
OCR_SERVICE_SECRET=dev_internal_ocr_secret_2026

# Document Upload & Extraction Limits
MAX_FILE_SIZE_BYTES=15728640
MAX_PAGES_LIMIT=10

# spaCy NLP Language Model (Pre-download via: python -m spacy download en_core_web_sm)
SPACY_MODEL=en_core_web_sm

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
