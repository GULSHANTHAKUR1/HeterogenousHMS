# ==============================================================================
# HETEROGENEOUS HMS - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS whitelist)
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
# Leave unset or empty to run in disconnected in-memory demo mode during local testing.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/heterogeneous_hms?retryWrites=true&w=majority

# Python OCR & NLP Microservice URL & Shared Internal Secret
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_SERVICE_SECRET=dev_internal_ocr_secret_2026
OCR_REQUEST_TIMEOUT_MS=30000

# Authentication & Cryptographic Keys
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET_SALT=replace_with_a_secure_random_otp_salt_min_32_chars

# SMS Gateway Configuration
# In development: 'mock' (logs simulated SMS delivery to console with masked phone)
# In production: 'twilio' | 'msg91' | 'aws_sns'
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# Optional Twilio Provider Configuration (Required only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC_example_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=example_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=+15550001234

# Development Fixed Demo Code (Sandbox testing only; ignored in production)
DEV_FIXED_OTP=482731
